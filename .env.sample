# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
VIYA_ENDPOINT=

# ---------------------------------------------------------------------------
# Use case — what this assistant is an expert on
# ---------------------------------------------------------------------------
# A short name and a sentence about the assistant (returned by get_use_case).
USE_CASE_NAME=
USE_CASE_DESCRIPTION=
# The dataset(s): CAS tables the assistant may query. The FIRST entry is the
# primary table the data tools default to. Each entry: table, caslib.table, or
# server.caslib.table (e.g. Public.PATIENTS). Comma- or newline-separated.
ALLOWED_TABLES=
# The ready models the assistant may score against, by MAS module id or name
# (as published from SAS Model Manager / Model Studio). ALLOWED_DECISIONS is
# the same list for published decisions; both feed one scoring allowlist.
ALLOWED_MODELS=
ALLOWED_DECISIONS=
# CAS server / caslib used when a table entry above omits them.
DEFAULT_CAS_SERVER=cas-shared-default
DEFAULT_CASLIB=Public
# true (default) blocks out-of-scope tables/models; false only hides them.
SCOPE_ENFORCE=true

# ---------------------------------------------------------------------------
# Headless authentication (direct HTTP mode — used by SAS RAM — and stdio mode)
# ---------------------------------------------------------------------------
# These modes log the server into Viya itself. Pick ONE of the two options:
#
# Option 1 (recommended) — Refresh token. Required when your Viya users sign
# in through an external identity provider (e.g. Okta SSO): the password grant
# below CANNOT authenticate federated users. Obtain a refresh token once with
#   uv run python examples/get_refresh_token.py
# then paste it here (store it as a secret wherever you deploy).
VIYA_REFRESH_TOKEN=

# Option 2 — Username/password (password grant). Works only for accounts SAS
# Logon authenticates directly (e.g. the local `sasboot` account or LDAP
# users). Used only when VIYA_REFRESH_TOKEN is empty.
VIYA_USERNAME=
VIYA_PASSWORD=

# Direct HTTP mode: protect the MCP endpoint with a static API key. Clients
# (SAS RAM: authentication "API Key") send it as X-API-Key or Authorization:
# Bearer. Strongly recommended — without it anyone who can reach the endpoint
# acts on Viya as the user above.
MCP_API_KEY=

# Direct HTTP mode transport — "http" (streamable HTTP, endpoint /mcp, default)
# or "sse" (Server-Sent Events, endpoint /sse).
MCP_TRANSPORT=http

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
CLIENT_ID=sas-mcp
# Only needed if you registered a confidential OAuth client (one with a
# secret). Leave empty for a public/PKCE client (the default registration).
CLIENT_SECRET=
HOST_PORT=8134
# Name shown to MCP clients in the handshake (handy when running several).
MCP_SERVER_NAME=SAS Use-Case MCP Server
# HTTP (OAuth) mode only:
MCP_SIGNING_KEY=default # Should be a strong random string in production
MCP_BASE_URL= # External URL of the MCP server (e.g. https://sas-mcp.company.com) — defaults to http://localhost:HOST_PORT
# Compute context the queries run in.
COMPUTE_CONTEXT_NAME=SAS Job Execution compute context
# Safety net: seconds a single query may run before it is abandoned and its
# compute session discarded. Ten minutes is far beyond any interactive query.
JOB_POLL_TIMEOUT=600
# Caps: rows one render_chart call accepts; records one score_data call scores.
MAX_CHART_ROWS=1000
MAX_SCORE_RECORDS=100
# Set to false to disable SSL verification (e.g. for self-signed Viya certificates)
SSL_VERIFY=true

# ---------------------------------------------------------------------------
# Container mode (optional)
# ---------------------------------------------------------------------------
# Which server the container runs: http-direct (default, for RAM hosting),
# http (OAuth PKCE), or stdio. Ignored outside the Docker image.
MCP_MODE=http-direct
